{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "resolution",
  "type": "object",
  "properties": {
    "unresolved_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": { "type": "string" },
          "candidates": {
            "type": "array",
            "items": {}
          },
          "sources": {
            "type": "array",
            "items": { "type": "string" }
          },
          "reason": {
            "type": "string",
            "enum": ["missing", "conflicting", "low_confidence"]
          }
        },
        "required": ["field", "reason"]
      }
    }
  },
  "required": ["unresolved_fields"]
}
